# Database
DATABASE_URL=postgresql://root:@127.0.0.1:5432/open_brain_studio
DIRECT_URL=postgresql://root:@127.0.0.1:5432/open_brain_studio

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=change_me_to_a_random_64_char_secret_in_production
JWT_REFRESH_SECRET=change_me_to_another_random_64_char_secret

# MinIO / S3-compatible storage
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_VIDEOS_RAW=obs-videos-raw
MINIO_BUCKET_VIDEOS_HLS=obs-videos-hls
MINIO_BUCKET_RESOURCES=obs-resources
MINIO_BUCKET_MEDIA=obs-media
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# App
NUXT_PUBLIC_API_BASE=/api
APP_URL=http://localhost:3000

LARAVEL_API_URL=http://open_brain.test
